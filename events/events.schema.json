{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anvilkit:events:v1",
  "title": "AnvilKit domain events",
  "description": "EventEnvelope and the versioned payloads of the event catalog (contracts.md §6 and event catalog). eventId is a standard UUID; opaque business identifiers travel in the envelope. No prompts, source bodies, tokens or grants enter an event. schemaVersion is 1. Each eventType binds its producer, subject, aggregateType and payload (P2.8).",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sequence": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "eventType": { "type": "string", "enum": ["operation.changed", "mcp.catalog-reviewed", "mcp.grant-revoked", "background.requested"], "description": "P2.8: the catalog holds the types that have a producer and a consumer in the codebase (contracts.md, event catalog). attempt.result-accepted, source.revision-indexed, source.authorization-revoked, memory.fact-confirmed/revoked and background.completed were removed with their consumer roles: their projections run inside the owner's own transactions or background requests." },
    "subject": { "type": "string", "pattern": "^anvilkit\\.(control|knowledge|mcp)\\.[a-z]+\\.[a-z-]+$" },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "schemaVersion", "producer", "subject", "tenantId", "aggregateType", "aggregateId", "aggregateRevision", "occurredAt", "correlationId"],
      "properties": {
        "eventId": { "$ref": "#/$defs/uuid" },
        "eventType": { "$ref": "#/$defs/eventType" },
        "schemaVersion": { "const": 1 },
        "producer": { "type": "string", "enum": ["anvilkit-agent-control", "anvilkit-agent-knowledge", "anvilkit-agent-mcp"] },
        "subject": { "$ref": "#/$defs/subject" },
        "tenantId": { "$ref": "#/$defs/id" },
        "aggregateType": { "type": "string", "enum": ["operation", "descriptor", "grant", "background_request"] },
        "aggregateId": { "$ref": "#/$defs/id" },
        "aggregateRevision": { "$ref": "#/$defs/sequence", "description": "Strictly increasing per (aggregateType, aggregateId) over every event of that aggregate (MCP-14): a consumer rejects a revision that is not greater than the last one it applied and repairs gaps through the owner. The business revision of the record, when it differs, travels in the payload." },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "correlationId": { "$ref": "#/$defs/id" },
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$", "description": "Correlation only; never authority." },
        "payloadRef": { "$ref": "#/$defs/digest" },
        "payload": { "oneOf": [{ "$ref": "#/$defs/operationChanged" }, { "$ref": "#/$defs/mcpCatalogReviewed" }, { "$ref": "#/$defs/mcpGrantRevoked" }, { "$ref": "#/$defs/backgroundRequested" }] }
      },
      "oneOf": [{ "required": ["payloadRef"] }, { "required": ["payload"] }],
      "allOf": [
        {
          "if": { "properties": { "eventType": { "const": "operation.changed" } } },
          "then": { "properties": { "producer": { "const": "anvilkit-agent-control" }, "aggregateType": { "const": "operation" }, "subject": { "const": "anvilkit.control.operation.changed" }, "payload": { "$ref": "#/$defs/operationChanged" } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "mcp.catalog-reviewed" } } },
          "then": { "properties": { "producer": { "const": "anvilkit-agent-mcp" }, "aggregateType": { "const": "descriptor" }, "subject": { "const": "anvilkit.mcp.mcp.catalog-reviewed" }, "payload": { "$ref": "#/$defs/mcpCatalogReviewed" } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "mcp.grant-revoked" } } },
          "then": { "properties": { "producer": { "const": "anvilkit-agent-mcp" }, "aggregateType": { "const": "grant" }, "subject": { "const": "anvilkit.mcp.mcp.grant-revoked" }, "payload": { "$ref": "#/$defs/mcpGrantRevoked" } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "background.requested" } } },
          "then": {
            "properties": { "aggregateType": { "const": "background_request" }, "payload": { "$ref": "#/$defs/backgroundRequested" } },
            "oneOf": [
              { "properties": { "producer": { "const": "anvilkit-agent-knowledge" }, "subject": { "const": "anvilkit.knowledge.background.requested" } } },
              { "properties": { "producer": { "const": "anvilkit-agent-mcp" }, "subject": { "const": "anvilkit.mcp.background.requested" } } }
            ]
          }
        }
      ]
    },
    "operationChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lifecycle", "phase", "control", "cleanup", "finance", "revision"],
      "properties": {
        "kind": { "type": "string", "enum": ["operation.changed"] },
        "lifecycle": { "type": "string", "enum": ["accepted", "running", "waiting", "reconciling", "suspended", "succeeded", "failed", "canceled"] },
        "phase": { "type": "string", "maxLength": 64 },
        "control": { "type": "string", "enum": ["none", "cancel_pending", "cancel_applied", "hold_pending", "hold_applied"] },
        "cleanup": { "type": "string", "enum": ["not_required", "pending", "complete", "unknown"] },
        "finance": { "type": "string", "enum": ["not_funded", "funded", "settling", "settled", "exposure_unknown"] },
        "revision": { "$ref": "#/$defs/sequence" },
        "failureCode": { "type": "string", "maxLength": 64 }
      }
    },
    "mcpCatalogReviewed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "serverId", "revision", "state"],
      "properties": {
        "kind": { "type": "string", "enum": ["mcp.catalog-reviewed"] },
        "serverId": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/sequence" },
        "state": { "type": "string", "enum": ["approved", "rejected", "disabled"] }
      }
    },
    "mcpGrantRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "grantId", "revision", "state"],
      "properties": {
        "kind": { "type": "string", "enum": ["mcp.grant-revoked"] },
        "grantId": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/sequence" },
        "state": { "type": "string", "enum": ["revoking", "revoked"] }
      }
    },
    "backgroundRequested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "taskId", "generation", "taskKind", "inputDigest"],
      "properties": {
        "kind": { "type": "string", "enum": ["background.requested"] },
        "taskId": { "$ref": "#/$defs/id" },
        "generation": { "$ref": "#/$defs/sequence" },
        "taskKind": { "type": "string", "enum": ["knowledge-ingest", "knowledge-project", "memory-project", "mcp-catalog-refresh", "local-check"], "description": "The stable queue kinds and local-check, the fixture kind of the background lane (fixed DEVELOPMENT_ONLY computation used to qualify owner claims, acceptance, the relays and the Worker; P14)." },
        "inputDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
